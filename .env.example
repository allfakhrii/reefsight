# ====================================================================
# REEFSIGHT: Environment Variables Configuration
# ====================================================================

# 1. Supabase Cloud (PostgreSQL 16 + PostGIS + Auth + Storage)
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. WhatsApp Gateway API (Fonnte / Wablas / Baileys)
# Digunakan untuk dispatch notifikasi darurat pemutihan & degradasi karang
WHATSAPP_API_TOKEN=your-whatsapp-gateway-token
WHATSAPP_GATEWAY_URL=https://api.fonnte.com/send
DEFAULT_OFFICER_PHONE=085892640228
